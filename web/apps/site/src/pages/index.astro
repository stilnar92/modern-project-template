---
// The app shell: no content pages yet. The page shows that the core answers.
import { m } from "@app/i18n";
import Base from "../layouts/Base.astro";
import { core } from "../lib/core";
import { readHealth } from "../lib/health";
import { heading, page, status } from "../styles/ui";

const health = await readHealth(core);
const label = health === "ok" ? m.core_status_ok() : m.core_status_unavailable();
---

<Base title={m.site_title()}>
  <main class={page()}>
    <h1 class={heading()}>{m.site_title()}</h1>
    <p role="status" class={status({ state: health === "ok" ? "ok" : "unavailable" })}>{label}</p>
  </main>
</Base>
