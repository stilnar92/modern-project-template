{
  "name": "app-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives-severity=error --no-error-on-unmatched-pattern && oxfmt --check --no-error-on-unmatched-pattern . && pnpm -r --if-present run typecheck && knip && pnpm legacy-scan",
    "format": "oxfmt --no-error-on-unmatched-pattern .",
    "mock": "prism mock ../api/openapi.yaml --port ${MOCK_PORT:-4010} --host 127.0.0.1",
    "test:e2e": "pnpm --filter @app/e2e test:e2e",
    "gen": "pnpm -r --if-present gen",
    "knip": "knip",
    "legacy-scan": "node scripts/legacy-scan.mjs",
    "postinstall": "pnpm --filter @app/i18n gen"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "5.16.0",
    "knip": "6.44.1",
    "modern-web-guidance": "1.0.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2"
  },
  "browserslist": [
    "baseline widely available"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@10.23.0"
}
