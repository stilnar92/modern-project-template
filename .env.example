# Local settings. "mise run up" copies this file to .env when .env does not exist.
# Do not commit .env. Production sets the same variables in its own way.

# Compose project name and host ports. "mise run env" (deploy/worktree-env.sh)
# sets the project name to the folder name and gives each git worktree a slot.
# Each port is the default plus the slot. The main checkout has slot 0.
COMPOSE_PROJECT_NAME=app
WORKTREE_SLOT=0
HTTP_PORT=8088
POSTGRES_PORT=54320
S3_PORT=8333
SMTP_PORT=1025

# Web dev servers and the Prism mock (mise run dev, mise run mock, mise run test:e2e).
MOCK_PORT=4010
DASHBOARD_PORT=5173
SITE_PORT=4330
# The core for the web apps. For the mock, set it to http://127.0.0.1:<MOCK_PORT>.
CORE_URL=http://api.localhost:8088

# Database passwords (local only).
POSTGRES_ADMIN_PASSWORD=local-admin
OWNER_DB_PASSWORD=local-owner
APP_DB_PASSWORD=local-app
SYSTEM_DB_PASSWORD=local-system

# Processes that run on the host (mise run run:api, mise run run:worker).
DATABASE_URL=postgres://app_app:local-app@localhost:54320/app?sslmode=disable
MIGRATE_DATABASE_URL=postgres://app_owner:local-owner@localhost:54320/app?sslmode=disable
# The BYPASSRLS role: only the jobs that ADR 0009 lists use it (the worker).
SYSTEM_DATABASE_URL=postgres://app_system:local-system@localhost:54320/app?sslmode=disable
# How many River jobs the worker runs at the same time.
WORKER_MAX_WORKERS=10

LOG_LEVEL=INFO
# Errors go to Sentry only when this is set.
SENTRY_DSN=
# Traces go out over OTLP only when this is set, for example http://localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
# The internal /metrics port of the api. The proxy does not route it.
# "mise run run:worker" uses WORKER_METRICS_PORT, so both can run on the host.
METRICS_PORT=9090
WORKER_METRICS_PORT=9091
