{
  "name": "docs-viewer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "content": "node scripts/link-content.mjs",
    "build": "node scripts/link-content.mjs && vitepress build",
    "preview": "vite preview --outDir .vitepress/dist --host 127.0.0.1 --port 4173",
    "dev": "node scripts/link-content.mjs && vitepress dev",
    "check": "node scripts/link-content.mjs && vitepress build && node scripts/check-html.mjs"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@scalar/api-reference": "1.76.4",
    "github-slugger": "2.0.0",
    "mermaid": "11.17.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "vite": "8.3.5",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vue": "3.5.44"
  }
}
